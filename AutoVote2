-- Script AutoVote para A Fazenda Fisher (Busca "Lorena" + Tecla V - 30 clics/seg)
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local TargetName = "Lorena" -- Nombre que aparece en la tarjeta
local TargetUserId = LocalPlayer.UserId -- Respaldo con tu avatar actual
local VelocidadClic = 0.023 -- Exactamente 30 clics por segundo

local scriptActivo = false
local cachedButton = nil

-- Crear Interfaz Flotante
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoVoteGUI_Lorena"
screenGui.ResetOnSpawn = false

pcall(function() screenGui.Parent = CoreGui end)
if not screenGui.Parent then screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 180, 0, 90)
mainFrame.Position = UDim2.new(0.05, 0, 0.25, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = mainFrame

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, 0, 0.4, 0)
statusLabel.Position = UDim2.new(0, 0, 0.08, 0)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "AHORA: OFF (Tecla 'V')"
statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
statusLabel.TextSize = 13
statusLabel.Font = Enum.Font.SourceSansBold
statusLabel.Parent = mainFrame

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0.85, 0, 0.38, 0)
toggleButton.Position = UDim2.new(0.075, 0, 0.52, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
toggleButton.Text = "ACTIVAR (V)"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.Parent = mainFrame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = toggleButton

local function toggleState()
    scriptActivo = not scriptActivo
    if scriptActivo then
        statusLabel.Text = "AHORA: ON (Tecla 'V')"
        statusLabel.TextColor3 = Color3.fromRGB(60, 255, 60)
        toggleButton.Text = "DESACTIVAR (V)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    else
        statusLabel.Text = "AHORA: OFF (Tecla 'V')"
        statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.Text = "ACTIVAR (V)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        cachedButton = nil
    end
end

-- Detectar la tecla "V" del teclado
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.V then
        toggleState()
    end
end)

toggleButton.MouseButton1Click:Connect(toggleState)

-- Busca la tarjeta por el nombre "Lorena" o por tu ID de avatar
local function findTargetCard()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    -- 1. Buscar por el texto "Lorena" en las placas de votación
    for _, element in pairs(playerGui:GetDescendants()) do
        if (element:IsA("TextLabel") or element:IsA("TextButton")) and string.find(string.lower(element.Text), string.lower(TargetName)) then
            if not element:FindFirstAncestorOfClass("BillboardGui") then
                local clickable = element:FindFirstAncestorOfClass("ImageButton") 
                               or element:FindFirstAncestorOfClass("TextButton") 
                               or element.Parent
                if clickable then
                    return clickable
                end
            end
        end
    end
    
    -- 2. Respaldo: Buscar por la imagen del avatar
    for _, element in pairs(playerGui:GetDescendants()) do
        if (element:IsA("ImageLabel") or element:IsA("ImageButton")) and not element:FindFirstAncestorOfClass("BillboardGui") then
            if string.find(tostring(element.Image), tostring(TargetUserId)) then
                return element:FindFirstAncestorOfClass("ImageButton") 
                    or element:FindFirstAncestorOfClass("TextButton") 
                    or element
            end
        end
    end
    
    return nil
end

-- Clic único y limpio en el centro de la tarjeta
local function singleClick(guiObject)
    local absPos = guiObject.AbsolutePosition
    local absSize = guiObject.AbsoluteSize
    local clickX = absPos.X + (absSize.X / 2)
    local clickY = absPos.Y + (absSize.Y / 2) + 36
    
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
    
    pcall(function()
        for _, conn in pairs(getconnections(guiObject.MouseButton1Click)) do conn:Fire() end
        for _, conn in pairs(getconnections(guiObject.TouchTap)) do conn:Fire() end
    end)
end

-- Bucle controlado de 30 clics por segundo
task.spawn(function()
    while true do
        if scriptActivo then
            if not cachedButton or not cachedButton:IsDescendantOf(game) then
                cachedButton = findTargetCard()
            end
            
            if cachedButton then
                pcall(function()
                    singleClick(cachedButton)
                end)
            end
            task.wait(VelocidadClic)
        else
            task.wait(0.1)
        end
    end
end)
